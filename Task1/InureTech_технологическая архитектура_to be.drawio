    </mxGraphModel>
  </diagram>
  <diagram id="tech-availability" name="Проверки и восстановление">
    <mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1280" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="kicker" parent="1" vertex="1" style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontColor=#14283E;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;rounded=0;spacing=0;" value="&lt;div style=&quot;font-family:Arial;font-size:14px;color:#205F99;line-height:1.24;margin-top:0px;font-weight:700;&quot;&gt;INSURETECH    /    СПРИНТ 08    /    TASK 1  /  02&lt;/div&gt;">
          <mxGeometry x="48" y="22" width="780" height="23" as="geometry" />
        </mxCell>
        <mxCell id="title" parent="1" vertex="1" style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontColor=#14283E;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;rounded=0;spacing=0;" value="&lt;div style=&quot;font-family:Arial;font-size:35px;color:#14283E;line-height:1.24;margin-top:0px;font-weight:700;&quot;&gt;Проверки и переключение трафика&lt;/div&gt;">
          <mxGeometry x="48" y="50" width="1430" height="49" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" parent="1" vertex="1" style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontColor=#14283E;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;rounded=0;spacing=0;" value="&lt;div style=&quot;font-family:Arial;font-size:17px;color:#425873;line-height:1.24;margin-top:0px;&quot;&gt;Доступность 99,9% · RTO ≤45 мин · RPO ≤15 мин для инфраструктурных отказов.&lt;/div&gt;">
          <mxGeometry x="49" y="104" width="1700" height="29" as="geometry" />
        </mxCell>
        <mxCell id="badge" parent="1" vertex="1" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontColor=#14283E;align=center;verticalAlign=middle;rounded=1;absoluteArcSize=1;arcSize=17;fillColor=#E8F1FC;strokeColor=none;" value="&lt;div style=&quot;font-family:Arial;font-size:14px;color:#205F99;line-height:1.24;margin-top:0px;font-weight:700;&quot;&gt;ЭКСПЛУАТАЦИЯ  /  DR&lt;/div&gt;">
          <mxGeometry x="1519" y="46" width="229" height="37" as="geometry" />
        </mxCell>
        <mxCell id="health-band" parent="1" vertex="1" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontColor=#14283E;align=center;verticalAlign=middle;rounded=1;absoluteArcSize=1;arcSize=14;fillColor=#EFF5FF;strokeColor=#EFF5FF;strokeWidth=1.4;">
          <mxGeometry x="48" y="153" width="844" height="36" as="geometry" />
        </mxCell>
        <mxCell id="health-band-title" parent="1" vertex="1" style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontColor=#14283E;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;rounded=0;spacing=0;" value="&lt;div style=&quot;font-family:Arial;font-size:16px;color:#205F99;line-height:1.24;margin-top:0px;font-weight:700;&quot;&gt;HEALTH CHECKS  /  ОТ КЛИЕНТА ДО ДАННЫХ&lt;/div&gt;">
          <mxGeometry x="61" y="153" width="819" height="36" as="geometry" />
        </mxCell>
        <mxCell id="recovery-band" parent="1" vertex="1" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontColor=#14283E;align=center;verticalAlign=middle;rounded=1;absoluteArcSize=1;arcSize=14;fillColor=#EFF5FF;strokeColor=#EFF5FF;strokeWidth=1.4;">
          <mxGeometry x="926" y="153" width="824" height="36" as="geometry" />
        </mxCell>
        <mxCell id="recovery-band-title" parent="1" vertex="1" style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontColor=#14283E;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;rounded=0;spacing=0;" value="&lt;div style=&quot;font-family:Arial;font-size:16px;color:#205F99;line-height:1.24;margin-top:0px;font-weight:700;&quot;&gt;FAILOVER  /  ДЕЙСТВИЯ И ВРЕМЕННЫЕ БЮДЖЕТЫ&lt;/div&gt;">
          <mxGeometry x="939" y="153" width="799" height="36" as="geometry" />
        </mxCell>
        <mxCell id="h1" parent="1" vertex="1" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontColor=#14283E;align=center;verticalAlign=middle;rounded=1;absoluteArcSize=1;arcSize=14;fillColor=#F6F9FD;strokeColor=#CFDDED;strokeWidth=1.4;">
          <mxGeometry x="48" y="205" width="844" height="125" as="geometry" />
        </mxCell>
        <mxCell id="h1-body" parent="1" vertex="1" style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontColor=#14283E;align=left;verticalAlign=top;strokeColor=none;fillColor=none;rounded=0;spacing=0;" value="&lt;div style=&quot;font-family:Arial;font-size:18px;color:#205F99;line-height:1.24;margin-top:0px;font-weight:700;&quot;&gt;H1   Внешние пробы → ALB&lt;/div&gt;&lt;div style=&quot;font-family:Arial;font-size:15px;color:#425873;line-height:1.24;margin-top:7px;&quot;&gt;HTTPS /ready/api: ingress, backend и запись в БД. Каждые 5 с из двух точек; 3 сбоя → алерт. Региональный ALB доступен через узлы в трёх зонах.&lt;/div&gt;&lt;div style=&quot;font-family:Arial;font-size:15px;color:#425873;line-height:1.24;margin-top:7px;&quot;&gt;При отказе одной зоны DNS и адрес API не меняются; трафик обслуживают оставшиеся зоны.&lt;/div&gt;">
          <mxGeometry x="66" y="218" width="808" height="99" as="geometry" />
        </mxCell>
        <mxCell id="h2" parent="1" vertex="1" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontColor=#14283E;align=center;verticalAlign=middle;rounded=1;absoluteArcSize=1;arcSize=14;fillColor=#F6F9FD;strokeColor=#CFDDED;strokeWidth=1.4;">
          <mxGeometry x="48" y="342" width="844" height="125" as="geometry" />
        </mxCell>
        <mxCell id="h2-body" parent="1" vertex="1" style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontColor=#14283E;align=left;verticalAlign=top;strokeColor=none;fillColor=none;rounded=0;spacing=0;" value="&lt;div style=&quot;font-family:Arial;font-size:18px;color:#205F99;line-height:1.24;margin-top:0px;font-weight:700;&quot;&gt;H2   L7 → Envoy → Service / под&lt;/div&gt;&lt;div style=&quot;font-family:Arial;font-size:15px;color:#425873;line-height:1.24;margin-top:7px;&quot;&gt;L7 проверяет HTTPS /readyz ingress (5 с × 3). Kubelet использует startup /startupz, readiness /readyz и liveness /livez для каждого Deployment.&lt;/div&gt;&lt;div style=&quot;font-family:Arial;font-size:15px;color:#425873;line-height:1.24;margin-top:7px;&quot;&gt;Readiness исключает под из EndpointSlice. Liveness проверяет процесс независимо от БД и страховщиков.&lt;/div&gt;">
          <mxGeometry x="66" y="355" width="808" height="99" as="geometry" />
        </mxCell>
        <mxCell id="h3" parent="1" vertex="1" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontColor=#14283E;align=center;verticalAlign=middle;rounded=1;absoluteArcSize=1;arcSize=14;fillColor=#F6F9FD;strokeColor=#CFDDED;strokeWidth=1.4;">
          <mxGeometry x="48" y="479" width="844" height="125" as="geometry" />
        </mxCell>
        <mxCell id="h3-body" parent="1" vertex="1" style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontColor=#14283E;align=left;verticalAlign=top;strokeColor=none;fillColor=none;rounded=0;spacing=0;" value="&lt;div style=&quot;font-family:Arial;font-size:18px;color:#205F99;line-height:1.24;margin-top:0px;font-weight:700;&quot;&gt;H3   HAProxy → Patroni / PostgreSQL&lt;/div&gt;&lt;div style=&quot;font-family:Arial;font-size:15px;color:#425873;line-height:1.24;margin-top:7px;&quot;&gt;GET /primary каждые 2 с, 3 сбоя исключают цель pg-rw. /replica + lag ограничивают pg-ro. Watchdog останавливает старого лидера при потере DCS.&lt;/div&gt;&lt;div style=&quot;font-family:Arial;font-size:15px;color:#425873;line-height:1.24;margin-top:7px;&quot;&gt;Пул переподключается к новому лидеру. Только Patroni управляет выбором primary.&lt;/div&gt;">
          <mxGeometry x="66" y="492" width="808" height="99" as="geometry" />
        </mxCell>
        <mxCell id="h4" parent="1" vertex="1" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontColor=#14283E;align=center;verticalAlign=middle;rounded=1;absoluteArcSize=1;arcSize=14;fillColor=#F6F9FD;strokeColor=#CFDDED;strokeWidth=1.4;">
          <mxGeometry x="48" y="616" width="844" height="125" as="geometry" />
        </mxCell>
        <mxCell id="h4-body" parent="1" vertex="1" style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontColor=#14283E;align=left;verticalAlign=top;strokeColor=none;fillColor=none;rounded=0;spacing=0;" value="&lt;div style=&quot;font-family:Arial;font-size:18px;color:#205F99;line-height:1.24;margin-top:0px;font-weight:700;&quot;&gt;H4   CDN, origins и архив WAL&lt;/div&gt;&lt;div style=&quot;font-family:Arial;font-size:15px;color:#425873;line-height:1.24;margin-top:7px;&quot;&gt;GET страницы и каталога с проверкой версии; возраст успешного архивирования WAL и тест чтения копии. Пробы каждую минуту.&lt;/div&gt;&lt;div style=&quot;font-family:Arial;font-size:15px;color:#425873;line-height:1.24;margin-top:7px;&quot;&gt;Раз в месяц - восстановление 50 GB и проверка контрольных сумм. Отдельно проверять холодный кеш CDN.&lt;/div&gt;">
          <mxGeometry x="66" y="629" width="808" height="99" as="geometry" />
        </mxCell>
        <mxCell id="f01" parent="1" vertex="1" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontColor=#14283E;align=center;verticalAlign=middle;rounded=1;absoluteArcSize=1;arcSize=14;fillColor=#F6F9FD;strokeColor=#CFDDED;strokeWidth=1.4;">
          <mxGeometry x="926" y="205" width="824" height="125" as="geometry" />
        </mxCell>
        <mxCell id="f01-body" parent="1" vertex="1" style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontColor=#14283E;align=left;verticalAlign=top;strokeColor=none;fillColor=none;rounded=0;spacing=0;" value="&lt;div style=&quot;font-family:Arial;font-size:18px;color:#205F99;line-height:1.24;margin-top:0px;font-weight:700;&quot;&gt;01   Отказ пода или ingress · ≤1 мин&lt;/div&gt;&lt;div style=&quot;font-family:Arial;font-size:15px;color:#425873;line-height:1.24;margin-top:7px;&quot;&gt;Readiness исключает неисправный pod. ALB направляет трафик на здоровый ingress. Клиент повторяет чтение с backoff; запись - с тем же Idempotency-Key.&lt;/div&gt;">
          <mxGeometry x="944" y="218" width="788" height="99" as="geometry" />
        </mxCell>
        <mxCell id="f02" parent="1" vertex="1" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontColor=#14283E;align=center;verticalAlign=middle;rounded=1;absoluteArcSize=1;arcSize=14;fillColor=#F6F9FD;strokeColor=#CFDDED;strokeWidth=1.4;">
          <mxGeometry x="926" y="342" width="824" height="125" as="geometry" />
        </mxCell>
        <mxCell id="f02-body" parent="1" vertex="1" style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontColor=#14283E;align=left;verticalAlign=top;strokeColor=none;fillColor=none;rounded=0;spacing=0;" value="&lt;div style=&quot;font-family:Arial;font-size:18px;color:#205F99;line-height:1.24;margin-top:0px;font-weight:700;&quot;&gt;02   Потеря зоны или её связи · ≤2 мин&lt;/div&gt;&lt;div style=&quot;font-family:Arial;font-size:15px;color:#425873;line-height:1.24;margin-top:7px;&quot;&gt;Две оставшиеся зоны сохраняют кворум etcd, ресурсы приложений и синхронную пару PostgreSQL. Изолированный primary останавливается watchdog. Новый лидер содержит подтверждённые записи: RPO = 0.&lt;/div&gt;">
          <mxGeometry x="944" y="355" width="788" height="99" as="geometry" />
        </mxCell>
        <mxCell id="f03" parent="1" vertex="1" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontColor=#14283E;align=center;verticalAlign=middle;rounded=1;absoluteArcSize=1;arcSize=14;fillColor=#F6F9FD;strokeColor=#CFDDED;strokeWidth=1.4;">
          <mxGeometry x="926" y="479" width="824" height="125" as="geometry" />
        </mxCell>
        <mxCell id="f03-body" parent="1" vertex="1" style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontColor=#14283E;align=left;verticalAlign=top;strokeColor=none;fillColor=none;rounded=0;spacing=0;" value="&lt;div style=&quot;font-family:Arial;font-size:18px;color:#205F99;line-height:1.24;margin-top:0px;font-weight:700;&quot;&gt;03   Отказ удалённого архива WAL&lt;/div&gt;&lt;div style=&quot;font-family:Arial;font-size:15px;color:#425873;line-height:1.24;margin-top:7px;&quot;&gt;При доступной локальной синхронной паре запись продолжается: её не блокирует отставание удалённого бэкапа. Архив догоняет после восстановления связи; резервный канал используется при сбое основного.&lt;/div&gt;">
          <mxGeometry x="944" y="492" width="788" height="99" as="geometry" />
        </mxCell>
        <mxCell id="f04" parent="1" vertex="1" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontColor=#14283E;align=center;verticalAlign=middle;rounded=1;absoluteArcSize=1;arcSize=14;fillColor=#F6F9FD;strokeColor=#CFDDED;strokeWidth=1.4;">
          <mxGeometry x="926" y="616" width="824" height="125" as="geometry" />
        </mxCell>
        <mxCell id="f04-body" parent="1" vertex="1" style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontColor=#14283E;align=left;verticalAlign=top;strokeColor=none;fillColor=none;rounded=0;spacing=0;" value="&lt;div style=&quot;font-family:Arial;font-size:18px;color:#205F99;line-height:1.24;margin-top:0px;font-weight:700;&quot;&gt;04   Восстановление из копии · цель ≤40 мин&lt;/div&gt;&lt;div style=&quot;font-family:Arial;font-size:15px;color:#425873;line-height:1.24;margin-top:7px;&quot;&gt;На резервных ВМ вне основного региона заранее готовы сеть, образы и конфигурация. Обнаружение и запуск - 5 мин; 50 GB при ≥50 MiB/с - 17 мин; WAL - 10 мин; приложения, проверка и DNS - 8 мин. Итого ≤40 мин от начала инцидента.&lt;/div&gt;">
          <mxGeometry x="944" y="629" width="788" height="99" as="geometry" />
        </mxCell>
        <mxCell id="data-band" parent="1" vertex="1" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontColor=#14283E;align=center;verticalAlign=middle;rounded=1;absoluteArcSize=1;arcSize=14;fillColor=#EFF5FF;strokeColor=#EFF5FF;strokeWidth=1.4;">
          <mxGeometry x="48" y="763" width="1702" height="36" as="geometry" />
        </mxCell>
        <mxCell id="data-band-title" parent="1" vertex="1" style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontColor=#14283E;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;rounded=0;spacing=0;" value="&lt;div style=&quot;font-family:Arial;font-size:16px;color:#205F99;line-height:1.24;margin-top:0px;font-weight:700;&quot;&gt;ДАННЫЕ  /  RPO, РЕЗЕРВНЫЕ КОПИИ И ПРОВЕРКА ВОССТАНОВЛЕНИЯ&lt;/div&gt;">
          <mxGeometry x="61" y="763" width="1677" height="36" as="geometry" />
        </mxCell>
        <mxCell id="rpo" parent="1" vertex="1" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontColor=#14283E;align=center;verticalAlign=middle;rounded=1;absoluteArcSize=1;arcSize=14;fillColor=#F6F9FD;strokeColor=#CFDDED;strokeWidth=1.4;">
          <mxGeometry x="48" y="815" width="551" height="255" as="geometry" />
        </mxCell>
        <mxCell id="rpo-body" parent="1" vertex="1" style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontColor=#14283E;align=left;verticalAlign=top;strokeColor=none;fillColor=none;rounded=0;spacing=0;" value="&lt;div style=&quot;font-family:Arial;font-size:18px;color:#205F99;line-height:1.24;margin-top:0px;font-weight:700;&quot;&gt;RPO и модель отказов&lt;/div&gt;&lt;div style=&quot;font-family:Arial;font-size:15px;color:#425873;line-height:1.24;margin-top:7px;&quot;&gt;Один отказ узла, зоны или межзонного канала: синхронный quorum сохраняет RPO = 0; большинство продолжает запись. WAN-реплики и отдельной межрегиональной аренды нет.&lt;/div&gt;&lt;div style=&quot;font-family:Arial;font-size:15px;color:#425873;line-height:1.24;margin-top:7px;&quot;&gt;Для PITR целевой RPO ≤15 мин: архив WAL каждую минуту, алерт при возрасте &amp;gt;5 мин и переключение канала. Одновременная потеря всего региона и обоих путей архивирования - отдельная катастрофа; без внешней актуальной копии RPO гарантировать нельзя.&lt;/div&gt;">
          <mxGeometry x="66" y="828" width="515" height="229" as="geometry" />
        </mxCell>
        <mxCell id="pitr" parent="1" vertex="1" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontColor=#14283E;align=center;verticalAlign=middle;rounded=1;absoluteArcSize=1;arcSize=14;fillColor=#F6F9FD;strokeColor=#CFDDED;strokeWidth=1.4;">
          <mxGeometry x="624" y="815" width="551" height="255" as="geometry" />
        </mxCell>
        <mxCell id="pitr-body" parent="1" vertex="1" style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontColor=#14283E;align=left;verticalAlign=top;strokeColor=none;fillColor=none;rounded=0;spacing=0;" value="&lt;div style=&quot;font-family:Arial;font-size:18px;color:#205F99;line-height:1.24;margin-top:0px;font-weight:700;&quot;&gt;Копии и восстановление&lt;/div&gt;&lt;div style=&quot;font-family:Arial;font-size:15px;color:#425873;line-height:1.24;margin-top:7px;&quot;&gt;pgBackRest: полная копия раз в неделю, инкремент ежедневно, WAL непрерывно. Хранение 35 дней. Изолированные ключи, запрет перезаписи и вторая копия у независимого провайдера в РФ.&lt;/div&gt;&lt;div style=&quot;font-family:Arial;font-size:15px;color:#425873;line-height:1.24;margin-top:7px;&quot;&gt;Ёмкость восстановления и доступ к копиям подготовлены заранее. На учениях проверять RTO целиком, включая обнаружение, WAL, приложения и контроль данных.&lt;/div&gt;">
          <mxGeometry x="642" y="828" width="515" height="229" as="geometry" />
        </mxCell>
        <mxCell id="budget" parent="1" vertex="1" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontColor=#14283E;align=center;verticalAlign=middle;rounded=1;absoluteArcSize=1;arcSize=14;fillColor=#F6F9FD;strokeColor=#CFDDED;strokeWidth=1.4;">
          <mxGeometry x="1200" y="815" width="550" height="255" as="geometry" />
        </mxCell>
        <mxCell id="budget-body" parent="1" vertex="1" style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontColor=#14283E;align=left;verticalAlign=top;strokeColor=none;fillColor=none;rounded=0;spacing=0;" value="&lt;div style=&quot;font-family:Arial;font-size:18px;color:#205F99;line-height:1.24;margin-top:0px;font-weight:700;&quot;&gt;Доступность 99,9%&lt;/div&gt;&lt;div style=&quot;font-family:Arial;font-size:15px;color:#425873;line-height:1.24;margin-top:7px;&quot;&gt;За 30 дней допустимо 43 мин 12 с простоя. Рабочие цели: сбой зоны ≤2 мин, PITR ≤40 мин при пределе RTO 45 мин. Все остановки записи входят в бюджет.&lt;/div&gt;&lt;div style=&quot;font-family:Arial;font-size:15px;color:#425873;line-height:1.24;margin-top:7px;&quot;&gt;Потеря большинства PostgreSQL/DCS останавливает запись ради целостности. Никакой кворум не гарантирует запись при произвольном разделении сети. Алерты по расходу бюджета; проверка отказа одной зоны до запуска рекламы.&lt;/div&gt;">
          <mxGeometry x="1218" y="828" width="514" height="229" as="geometry" />
        </mxCell>
        <mxCell id="network" parent="1" vertex="1" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontColor=#14283E;align=center;verticalAlign=middle;rounded=1;absoluteArcSize=1;arcSize=14;fillColor=#F6F9FD;strokeColor=#CFDDED;strokeWidth=1.4;">
          <mxGeometry x="48" y="1093" width="1702" height="110" as="geometry" />
        </mxCell>
        <mxCell id="network-body" parent="1" vertex="1" style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontColor=#14283E;align=left;verticalAlign=top;strokeColor=none;fillColor=none;rounded=0;spacing=0;" value="&lt;div style=&quot;font-family:Arial;font-size:18px;color:#205F99;line-height:1.24;margin-top:0px;font-weight:700;&quot;&gt;Границы доступа&lt;/div&gt;&lt;div style=&quot;font-family:Arial;font-size:15px;color:#425873;line-height:1.24;margin-top:7px;&quot;&gt;Открыты только CDN/origins и ALB. Security Groups и NetworkPolicy: ingress → Service → PostgreSQL. БД и Redis приватные. Все зоны заранее имеют сертификаты, сетевые разрешения и запас ресурсов на потерю одной зоны.&lt;/div&gt;">
          <mxGeometry x="66" y="1106" width="1666" height="84" as="geometry" />
        </mxCell>
        <mxCell id="references" parent="1" vertex="1" style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontColor=#14283E;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;rounded=0;spacing=0;" value="&lt;span style=&quot;font-family:Arial;font-size:13px&quot;&gt;&lt;a href=&quot;https://patroni.readthedocs.io/en/latest/replication_modes.html&quot; style=&quot;color:#205F99&quot;&gt;Patroni · режимы репликации&lt;/a&gt;　·　&lt;a href=&quot;https://patroni.readthedocs.io/en/latest/watchdog.html&quot; style=&quot;color:#205F99&quot;&gt;Patroni · watchdog&lt;/a&gt;　·　&lt;a href=&quot;https://pgbackrest.org/user-guide.html&quot; style=&quot;color:#205F99&quot;&gt;pgBackRest · руководство&lt;/a&gt;&lt;/span&gt;">
          <mxGeometry x="49" y="1216" width="1702" height="30" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="tech-capacity" name="Масштабирование и SLO">
    <mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="910" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="kicker" parent="1" vertex="1" style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontColor=#14283E;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;rounded=0;spacing=0;" value="&lt;div style=&quot;font-family:Arial;font-size:14px;color:#205F99;line-height:1.24;margin-top:0px;font-weight:700;&quot;&gt;INSURETECH    /    СПРИНТ 08    /    TASK 1  /  03&lt;/div&gt;">
          <mxGeometry x="48" y="22" width="780" height="23" as="geometry" />
        </mxCell>
        <mxCell id="title" parent="1" vertex="1" style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontColor=#14283E;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;rounded=0;spacing=0;" value="&lt;div style=&quot;font-family:Arial;font-size:35px;color:#14283E;line-height:1.24;margin-top:0px;font-weight:700;&quot;&gt;Ёмкость и задержки по регионам&lt;/div&gt;">
          <mxGeometry x="48" y="50" width="1430" height="49" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" parent="1" vertex="1" style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontColor=#14283E;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;rounded=0;spacing=0;" value="&lt;div style=&quot;font-family:Arial;font-size:17px;color:#425873;line-height:1.24;margin-top:0px;&quot;&gt;Проверяем географию с помощью RUM и синтетики, ёмкость - в нагрузочных тестах и при отключении зоны.&lt;/div&gt;">
          <mxGeometry x="49" y="104" width="1700" height="29" as="geometry" />
        </mxCell>
        <mxCell id="badge" parent="1" vertex="1" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontColor=#14283E;align=center;verticalAlign=middle;rounded=1;absoluteArcSize=1;arcSize=17;fillColor=#E8F1FC;strokeColor=none;" value="&lt;div style=&quot;font-family:Arial;font-size:14px;color:#205F99;line-height:1.24;margin-top:0px;font-weight:700;&quot;&gt;ПРОЕКТНЫЕ ЦЕЛИ&lt;/div&gt;">
          <mxGeometry x="1519" y="46" width="229" height="37" as="geometry" />
        </mxCell>
        <mxCell id="compute-band" parent="1" vertex="1" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontColor=#14283E;align=center;verticalAlign=middle;rounded=1;absoluteArcSize=1;arcSize=14;fillColor=#EFF5FF;strokeColor=#EFF5FF;strokeWidth=1.4;">
          <mxGeometry x="48" y="153" width="1702" height="36" as="geometry" />
        </mxCell>
        <mxCell id="compute-band-title" parent="1" vertex="1" style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontColor=#14283E;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;rounded=0;spacing=0;" value="&lt;div style=&quot;font-family:Arial;font-size:16px;color:#205F99;line-height:1.24;margin-top:0px;font-weight:700;&quot;&gt;ВЫЧИСЛЕНИЯ И ДАННЫЕ&lt;/div&gt;">
          <mxGeometry x="61" y="153" width="1677" height="36" as="geometry" />
        </mxCell>
        <mxCell id="horizontal" parent="1" vertex="1" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontColor=#14283E;align=center;verticalAlign=middle;rounded=1;absoluteArcSize=1;arcSize=14;fillColor=#F6F9FD;strokeColor=#CFDDED;strokeWidth=1.4;">
          <mxGeometry x="48" y="205" width="551" height="209" as="geometry" />
        </mxCell>
        <mxCell id="horizontal-body" parent="1" vertex="1" style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontColor=#14283E;align=left;verticalAlign=top;strokeColor=none;fillColor=none;rounded=0;spacing=0;" value="&lt;div style=&quot;font-family:Arial;font-size:18px;color:#205F99;line-height:1.24;margin-top:0px;font-weight:700;&quot;&gt;Горизонтальное масштабирование&lt;/div&gt;&lt;div style=&quot;font-family:Arial;font-size:15px;color:#425873;line-height:1.24;margin-top:7px;&quot;&gt;Online-сервисы: ≥3 реплик, минимум одна на зону; topology spread, PDB minAvailable 2 и rolling update без потери готовности. HPA добавляет pod, Cluster Autoscaler - узлы. Две зоны вместе должны выдерживать весь расчётный пик.&lt;/div&gt;">
          <mxGeometry x="66" y="218" width="515" height="183" as="geometry" />
        </mxCell>
        <mxCell id="vertical" parent="1" vertex="1" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontColor=#14283E;align=center;verticalAlign=middle;rounded=1;absoluteArcSize=1;arcSize=14;fillColor=#F6F9FD;strokeColor=#CFDDED;strokeWidth=1.4;">
          <mxGeometry x="624" y="205" width="551" height="209" as="geometry" />
        </mxCell>
        <mxCell id="vertical-body" parent="1" vertex="1" style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontColor=#14283E;align=left;verticalAlign=top;strokeColor=none;fillColor=none;rounded=0;spacing=0;" value="&lt;div style=&quot;font-family:Arial;font-size:18px;color:#205F99;line-height:1.24;margin-top:0px;font-weight:700;&quot;&gt;Вертикально · БД и размеры подов&lt;/div&gt;&lt;div style=&quot;font-family:Arial;font-size:16px;color:#425873;line-height:1.24;margin-top:7px;&quot;&gt;Для PostgreSQL сначала индексы, лимиты пулов, анализ медленных запросов и увеличение CPU/RAM/IOPS. Реплики обслуживают чтение с допустимым отставанием. После записи читаем с лидера. Requests подов уточняем по профилям.&lt;/div&gt;">
          <mxGeometry x="642" y="218" width="515" height="183" as="geometry" />
        </mxCell>
        <mxCell id="zones" parent="1" vertex="1" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontColor=#14283E;align=center;verticalAlign=middle;rounded=1;absoluteArcSize=1;arcSize=14;fillColor=#F6F9FD;strokeColor=#CFDDED;strokeWidth=1.4;">
          <mxGeometry x="1200" y="205" width="550" height="209" as="geometry" />
        </mxCell>
        <mxCell id="zones-body" parent="1" vertex="1" style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontColor=#14283E;align=left;verticalAlign=top;strokeColor=none;fillColor=none;rounded=0;spacing=0;" value="&lt;div style=&quot;font-family:Arial;font-size:18px;color:#205F99;line-height:1.24;margin-top:0px;font-weight:700;&quot;&gt;Один кластер в трёх зонах&lt;/div&gt;&lt;div style=&quot;font-family:Arial;font-size:15px;color:#425873;line-height:1.24;margin-top:7px;&quot;&gt;HA control plane и node pools в ru-central1-a/b/d. Зоны близки: нет WAN в control plane и PostgreSQL. Один кластер проще обновлять, наблюдать и восстанавливать. Отдельные кластеры на каждую зону не дают преимущества для этой нагрузки.&lt;/div&gt;">
          <mxGeometry x="1218" y="218" width="514" height="183" as="geometry" />
        </mxCell>
        <mxCell id="latency-band" parent="1" vertex="1" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontColor=#14283E;align=center;verticalAlign=middle;rounded=1;absoluteArcSize=1;arcSize=14;fillColor=#EFF5FF;strokeColor=#EFF5FF;strokeWidth=1.4;">
          <mxGeometry x="48" y="442" width="1702" height="36" as="geometry" />
        </mxCell>
        <mxCell id="latency-band-title" parent="1" vertex="1" style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontColor=#14283E;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;rounded=0;spacing=0;" value="&lt;div style=&quot;font-family:Arial;font-size:16px;color:#205F99;line-height:1.24;margin-top:0px;font-weight:700;&quot;&gt;СКОРОСТЬ СТРАНИЦ И ИЗОЛЯЦИЯ НАГРУЗКИ&lt;/div&gt;">
          <mxGeometry x="61" y="442" width="1677" height="36" as="geometry" />
        </mxCell>
        <mxCell id="latency" parent="1" vertex="1" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontColor=#14283E;align=center;verticalAlign=middle;rounded=1;absoluteArcSize=1;arcSize=14;fillColor=#F6F9FD;strokeColor=#CFDDED;strokeWidth=1.4;">
          <mxGeometry x="48" y="494" width="551" height="298" as="geometry" />
        </mxCell>
        <mxCell id="latency-body" parent="1" vertex="1" style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontColor=#14283E;align=left;verticalAlign=top;strokeColor=none;fillColor=none;rounded=0;spacing=0;" value="&lt;div style=&quot;font-family:Arial;font-size:18px;color:#205F99;line-height:1.24;margin-top:0px;font-weight:700;&quot;&gt;Загрузка страниц во всех регионах&lt;/div&gt;&lt;div style=&quot;font-family:Arial;font-size:15px;color:#425873;line-height:1.24;margin-top:7px;&quot;&gt;HTML, CSS, JS, изображения и публичный каталог JSON отдаются из ближайшего CDN POP. Каталог публикуется версионно; популярные страницы и ассеты прогреваются. Экран не ждёт цепочки запросов к страховщикам.&lt;/div&gt;&lt;div style=&quot;font-family:Arial;font-size:15px;color:#425873;line-height:1.24;margin-top:7px;&quot;&gt;Личные данные загружаются асинхронно через API и не кешируются в публичном CDN. Их время готовности измеряется отдельно: LCP пустого каркаса не считается успешной загрузкой личного кабинета.&lt;/div&gt;">
          <mxGeometry x="66" y="507" width="515" height="272" as="geometry" />
        </mxCell>
        <mxCell id="sla" parent="1" vertex="1" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontColor=#14283E;align=center;verticalAlign=middle;rounded=1;absoluteArcSize=1;arcSize=14;fillColor=#F6F9FD;strokeColor=#CFDDED;strokeWidth=1.4;">
          <mxGeometry x="624" y="494" width="551" height="298" as="geometry" />
        </mxCell>
        <mxCell id="sla-body" parent="1" vertex="1" style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontColor=#14283E;align=left;verticalAlign=top;strokeColor=none;fillColor=none;rounded=0;spacing=0;" value="&lt;div style=&quot;font-family:Arial;font-size:18px;color:#205F99;line-height:1.24;margin-top:0px;font-weight:700;&quot;&gt;Единые критерии для регионов&lt;/div&gt;&lt;div style=&quot;font-family:Arial;font-size:15px;color:#425873;line-height:1.24;margin-top:7px;&quot;&gt;Для каждого часового пояса: p95 загрузки публичной страницы ≤2,5 с и разброс ≤300 мс при одинаковой сети/устройстве. Проверять холодный и тёплый кеш. Для кабинета - p95 до появления личных данных ≤2,5 с; при превышении оптимизировать API до запуска.&lt;/div&gt;&lt;div style=&quot;font-family:Arial;font-size:15px;color:#425873;line-height:1.24;margin-top:7px;&quot;&gt;Одинаковое время загрузки оценивается по единому SLO во всех часовых поясах при одинаковых условиях сети. Физически одинаковый RTT при произвольной сети недостижим; задержки API включаются в измерение страницы.&lt;/div&gt;">
          <mxGeometry x="642" y="507" width="515" height="272" as="geometry" />
        </mxCell>
        <mxCell id="isolation" parent="1" vertex="1" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontColor=#14283E;align=center;verticalAlign=middle;rounded=1;absoluteArcSize=1;arcSize=14;fillColor=#F6F9FD;strokeColor=#CFDDED;strokeWidth=1.4;">
          <mxGeometry x="1200" y="494" width="550" height="298" as="geometry" />
        </mxCell>
        <mxCell id="isolation-body" parent="1" vertex="1" style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontColor=#14283E;align=left;verticalAlign=top;strokeColor=none;fillColor=none;rounded=0;spacing=0;" value="&lt;div style=&quot;font-family:Arial;font-size:18px;color:#205F99;line-height:1.24;margin-top:0px;font-weight:700;&quot;&gt;Ёмкость, квоты и шардирование&lt;/div&gt;&lt;div style=&quot;font-family:Arial;font-size:15px;color:#425873;line-height:1.24;margin-top:7px;&quot;&gt;Нагрузочный сценарий: 100 RPS поиска, 20 RPS оформления плюс квоты B2B. Партнёрские 250 RPS ограничиваются общим Redis-лимитером до 20 RPS по всем ingress: 429 + Retry-After. Пулы B2C/B2B изолированы.&lt;/div&gt;&lt;div style=&quot;font-family:Arial;font-size:15px;color:#425873;line-height:1.24;margin-top:7px;&quot;&gt;Для 50 GB шардирование не требуется: сначала индексы, пулы, IOPS и вертикальный рост PostgreSQL. При недоступном лимитере B2B получает 503, B2C обслуживается независимо.&lt;/div&gt;">
          <mxGeometry x="1218" y="507" width="514" height="272" as="geometry" />
        </mxCell>
        <mxCell id="references" parent="1" vertex="1" style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontColor=#14283E;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;rounded=0;spacing=0;" value="&lt;span style=&quot;font-family:Arial;font-size:13px&quot;&gt;&lt;a href=&quot;https://yandex.cloud/ru/docs/cdn/concepts/points-of-presence&quot; style=&quot;color:#205F99&quot;&gt;Yandex Cloud CDN · точки присутствия&lt;/a&gt;　·　&lt;a href=&quot;https://yandex.cloud/ru/docs/cdn/concepts/fault-tolerance&quot; style=&quot;color:#205F99&quot;&gt;Cloud CDN · отказоустойчивость источников&lt;/a&gt;　·　&lt;a href=&quot;https://yandex.cloud/ru/docs/overview/concepts/geo-scope&quot; style=&quot;color:#205F99&quot;&gt;Yandex Cloud · зоны доступности&lt;/a&gt;&lt;/span&gt;">
          <mxGeometry x="49" y="831" width="1702" height="30" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
