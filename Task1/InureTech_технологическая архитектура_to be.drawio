        <mxCell id="choice" parent="1" vertex="1" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontColor=#14283E;align=center;verticalAlign=middle;rounded=1;absoluteArcSize=1;arcSize=14;fillColor=#F6F9FD;strokeColor=#CFDDED;strokeWidth=1.4;">
