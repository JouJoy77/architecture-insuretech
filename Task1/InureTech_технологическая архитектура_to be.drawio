        <mxCell id="pg-text" parent="1" vertex="1" style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontColor=#14283E;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;rounded=0;spacing=0;" value="&lt;div style=&quot;font-family:Arial;font-size:18px;color:#14283E;line-height:1.24;margin-top:0px;font-weight:700;&quot;&gt;PostgreSQL HA · Patroni&lt;/div&gt;&lt;div style=&quot;font-family:Arial;font-size:15px;color:#14283E;line-height:1.24;margin-top:5px;&quot;&gt;Primary + 2 standby, по узлу на зону&lt;/div&gt;&lt;div style=&quot;font-family:Arial;font-size:15px;color:#14283E;line-height:1.24;margin-top:5px;&quot;&gt;WAL sync ANY 1 · synchronous_mode=quorum, strict=true&lt;/div&gt;&lt;div style=&quot;font-family:Arial;font-size:15px;color:#14283E;line-height:1.24;margin-top:5px;&quot;&gt;etcd ×3 по зонам · watchdog / fencing&lt;/div&gt;&lt;div style=&quot;font-family:Arial;font-size:15px;color:#14283E;line-height:1.24;margin-top:5px;&quot;&gt;HAProxy + PgBouncer: pg-rw → лидер, pg-ro → replica · H3&lt;/div&gt;">
