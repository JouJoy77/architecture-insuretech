        </mxCell>
        <mxCell id="web-cdn" parent="1" edge="1" source="browser" target="cdn" style="noEdgeStyle=1;rounded=0;html=1;jumpStyle=arc;jumpSize=9;strokeColor=#205F99;strokeWidth=2;endArrow=blockThin;endSize=10;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;">
