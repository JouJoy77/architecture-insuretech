          <mxGeometry x="48" y="151" width="1702" height="36" as="geometry" />
        </mxCell>
        <mxCell id="catalog-band-title" parent="1" vertex="1" style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontColor=#14283E;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;rounded=0;spacing=0;" value="&lt;div style=&quot;font-family:Arial;font-size:16px;color:#205F99;line-height:1.24;margin-top:0px;font-weight:700;&quot;&gt;КАТАЛОГ  /  INSURANCE.CATALOG.V1&lt;/div&gt;">
          <mxGeometry x="61" y="151" width="1677" height="36" as="geometry" />
        </mxCell>
        <mxCell id="policies-band" parent="1" vertex="1" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontColor=#14283E;align=center;verticalAlign=middle;rounded=1;absoluteArcSize=1;arcSize=14;fillColor=#EFF5FF;strokeColor=#EFF5FF;strokeWidth=1.4;">
