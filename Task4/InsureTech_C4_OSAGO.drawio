          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="step0-edge2" parent="1" edge="1" source="step0-2" target="step0-3" style="noEdgeStyle=1;rounded=0;html=1;jumpStyle=arc;jumpSize=9;strokeColor=#5C4EA0;strokeWidth=2;endArrow=blockThin;endSize=10;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;">
