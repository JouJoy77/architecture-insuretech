          <mxGeometry x="61" y="366" width="1677" height="36" as="geometry" />
        </mxCell>
        <mxCell id="step0-0" parent="1" vertex="1" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontColor=#14283E;align=center;verticalAlign=middle;rounded=1;absoluteArcSize=1;arcSize=14;fillColor=#F6F9FD;strokeColor=#CFDDED;strokeWidth=1.4;">
          <mxGeometry x="48" y="202" width="397" height="137" as="geometry" />
        </mxCell>
        <mxCell id="step0-0-body" parent="1" vertex="1" style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontColor=#14283E;align=left;verticalAlign=top;strokeColor=none;fillColor=none;rounded=0;spacing=0;" value="&lt;div style=&quot;font-family:Arial;font-size:18px;color:#205F99;line-height:1.24;margin-top:0px;font-weight:700;&quot;&gt;API 5 → 10 страховщиков&lt;/div&gt;&lt;div style=&quot;font-family:Arial;font-size:15px;color:#425873;line-height:1.24;margin-top:7px;&quot;&gt;Опрос каждые 5 мин со сдвигом. Таймаут и квота на страховщика. Сбой сохраняет последний валидный снимок.&lt;/div&gt;">
          <mxGeometry x="66" y="215" width="361" height="111" as="geometry" />
        </mxCell>
        <mxCell id="step0-1" parent="1" vertex="1" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontColor=#14283E;align=center;verticalAlign=middle;rounded=1;absoluteArcSize=1;arcSize=14;fillColor=#F6F9FD;strokeColor=#CFDDED;strokeWidth=1.4;">
          <mxGeometry x="483" y="202" width="397" height="137" as="geometry" />
        </mxCell>
        <mxCell id="step0-1-body" parent="1" vertex="1" style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontColor=#14283E;align=left;verticalAlign=top;strokeColor=none;fillColor=none;rounded=0;spacing=0;" value="&lt;div style=&quot;font-family:Arial;font-size:18px;color:#205F99;line-height:1.24;margin-top:0px;font-weight:700;&quot;&gt;ins-product-aggregator&lt;/div&gt;&lt;div style=&quot;font-family:Arial;font-size:15px;color:#425873;line-height:1.24;margin-top:7px;&quot;&gt;Проверяет полноту, нормализует тарифы. В одной транзакции catalog-db пишет изменения, время опроса и outbox.&lt;/div&gt;">
          <mxGeometry x="501" y="215" width="361" height="111" as="geometry" />
        </mxCell>
        <mxCell id="step0-2" parent="1" vertex="1" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontColor=#14283E;align=center;verticalAlign=middle;rounded=1;absoluteArcSize=1;arcSize=14;fillColor=#F6F9FD;strokeColor=#CFDDED;strokeWidth=1.4;">
          <mxGeometry x="918" y="202" width="397" height="137" as="geometry" />
        </mxCell>
        <mxCell id="step0-2-body" parent="1" vertex="1" style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontColor=#14283E;align=left;verticalAlign=top;strokeColor=none;fillColor=none;rounded=0;spacing=0;" value="&lt;div style=&quot;font-family:Arial;font-size:18px;color:#205F99;line-height:1.24;margin-top:0px;font-weight:700;&quot;&gt;Debezium → Kafka&lt;/div&gt;&lt;div style=&quot;font-family:Arial;font-size:15px;color:#425873;line-height:1.24;margin-top:7px;&quot;&gt;Changed / Withdrawn: полное состояние тарифа и версия, ключ insurerId:productId:tariffId. Refreshed - факт опроса, не готовность проекций.&lt;/div&gt;">
          <mxGeometry x="936" y="215" width="361" height="111" as="geometry" />
        </mxCell>
        <mxCell id="step0-3" parent="1" vertex="1" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontColor=#14283E;align=center;verticalAlign=middle;rounded=1;absoluteArcSize=1;arcSize=14;fillColor=#F6F9FD;strokeColor=#CFDDED;strokeWidth=1.4;">
          <mxGeometry x="1353" y="202" width="397" height="137" as="geometry" />
        </mxCell>
        <mxCell id="step0-3-body" parent="1" vertex="1" style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontColor=#14283E;align=left;verticalAlign=top;strokeColor=none;fillColor=none;rounded=0;spacing=0;" value="&lt;div style=&quot;font-family:Arial;font-size:18px;color:#205F99;line-height:1.24;margin-top:0px;font-weight:700;&quot;&gt;Два независимых читателя&lt;/div&gt;&lt;div style=&quot;font-family:Arial;font-size:15px;color:#425873;line-height:1.24;margin-top:7px;&quot;&gt;core-app и ins-comp-settlement обновляют свои проекции в разных consumer groups.&lt;/div&gt;">
          <mxGeometry x="1371" y="215" width="361" height="111" as="geometry" />
        </mxCell>
        <mxCell id="step0-edge0" parent="1" edge="1" source="step0-0" target="step0-1" style="noEdgeStyle=1;rounded=0;html=1;jumpStyle=arc;jumpSize=9;strokeColor=#5C4EA0;strokeWidth=2;endArrow=blockThin;endSize=10;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;">
