          <mxGeometry x="49" y="104" width="1700" height="29" as="geometry" />
        </mxCell>
        <mxCell id="badge" parent="1" vertex="1" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontColor=#14283E;align=center;verticalAlign=middle;rounded=1;absoluteArcSize=1;arcSize=17;fillColor=#E8F1FC;strokeColor=none;" value="&lt;div style=&quot;font-family:Arial;font-size:14px;color:#205F99;line-height:1.24;margin-top:0px;font-weight:700;&quot;&gt;КОНТРАКТЫ  /  ДОСТАВКА&lt;/div&gt;">
          <mxGeometry x="1519" y="46" width="229" height="37" as="geometry" />
        </mxCell>
